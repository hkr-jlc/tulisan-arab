    <levels>
        <level id="1" name="Huruf Hijaiyah" description="Mengenal 28 huruf Arab dasar" locked="false">
            <materi>
                <item id="1" arab="ا" latin="Alif" sound="a" type="huruf">
                    <desc>Huruf mati (tidak berharakat) dibaca seperti a pada kata 'adil'</desc>
                    <contoh>
                        <kata arab="اَ" latin="Ba" arti="huruf A dengan fathah"/>
                    </contoh>
                </item>
                <item id="2" arab="ب" latin="Ba" sound="b" type="huruf">
                    <desc>Dibaca seperti huruf B pada kata 'buku'</desc>
                    <contoh>
                        <kata arab="بَ" latin="Ba" arti="huruf B dengan fathah"/>
                    </contoh>
                </item>
                <item id="3" arab="ت" latin="Ta" sound="t" type="huruf">
                    <desc>Dibaca seperti huruf T pada kata 'tali', lidah menyentuh gigi seri atas</desc>
                    <contoh>
                        <kata arab="تَ" latin="Ta" arti="huruf T dengan fathah"/>
                    </contoh>
                </item>
                <item id="4" arab="ث" latin="Tsa" sound="ts" type="huruf">
                    <desc>Dibaca seperti huruf S pada kata 'sabar', lidah di antara gigi</desc>
                    <contoh>
                        <kata arab="ثَ" latin="Tsa" arti="huruf Tsa dengan fathah"/>
                    </contoh>
                </item>
                <item id="5" arab="ج" latin="Jim" sound="j" type="huruf">
                    <desc>Dibaca seperti huruf J pada kata 'jalan', tenggorokan sedikit ditekan</desc>
                    <contoh>
                        <kata arab="جَ" latin="Ja" arti="huruf Jim dengan fathah"/>
                    </contoh>
                </item>
                <item id="6" arab="ح" latin="Ha" sound="h" type="huruf">
                    <desc>Dibaca dengan hembusan dari tenggorokan, lebih kasar dari huruf H biasa</desc>
                    <contoh>
                        <kata arab="حَ" latin="Ha" arti="huruf Ha dengan fathah"/>
                    </contoh>
                </item>
                <item id="7" arab="خ" latin="Kha" sound="kh" type="huruf">
                    <desc>Dibaca seperti suara mengorok dari tenggorokan bagian belakang</desc>
                    <contoh>
                        <kata arab="خَ" latin="Kha" arti="huruf Kha dengan fathah"/>
                    </contoh>
                </item>
                <item id="8" arab="د" latin="Dal" sound="d" type="huruf">
                    <desc>Dibaca seperti huruf D pada kata 'dagu', lidah menyentuh gigi</desc>
                    <contoh>
                        <kata arab="دَ" latin="Da" arti="huruf Dal dengan fathah"/>
                    </contoh>
                </item>
                <item id="9" arab="ذ" latin="Dzal" sound="dz" type="huruf">
                    <desc>Dibaca seperti huruf Z pada kata 'zaman', lidah di antara gigi</desc>
                    <contoh>
                        <kata arab="ذَ" latin="Dza" arti="huruf Dzal dengan fathah"/>
                    </contoh>
                </item>
                <item id="10" arab="ر" latin="Ra" sound="r" type="huruf">
                    <desc>Dibaca dengan getaran lidah (rolled R), seperti bahasa Spanyol</desc>
                    <contoh>
                        <kata arab="رَ" latin="Ra" arti="huruf Ra dengan fathah"/>
                    </contoh>
                </item>
                <item id="11" arab="ز" latin="Zay" sound="z" type="huruf">
                    <desc>Dibaca seperti huruf Z pada kata 'zebra'</desc>
                    <contoh>
                        <kata arab="زَ" latin="Za" arti="huruf Zay dengan fathah"/>
                    </contoh>
                </item>
                <item id="12" arab="س" latin="Sin" sound="s" type="huruf">
                    <desc>Dibaca seperti huruf S pada kata 'sapi', lidah di bawah gigi</desc>
                    <contoh>
                        <kata arab="سَ" latin="Sa" arti="huruf Sin dengan fathah"/>
                    </contoh>
                </item>
                <item id="13" arab="ش" latin="Syin" sound="sy" type="huruf">
                    <desc>Dibaca seperti SY pada kata 'Syahrini', tengah lidah ke langit-langit</desc>
                    <contoh>
                        <kata arab="شَ" latin="Sya" arti="huruf Syin dengan fathah"/>
                    </contoh>
                </item>
                <item id="14" arab="ص" latin="Shad" sound="sh" type="huruf">
                    <desc>Dibaca seperti S yang tebal, lidah lebih ditekankan ke belakang</desc>
                    <contoh>
                        <kata arab="صَ" latin="Sha" arti="huruf Shad dengan fathah"/>
                    </contoh>
                </item>
                <item id="15" arab="ض" latin="Dhad" sound="dh" type="huruf">
                    <desc>Dibaca seperti D yang tebal, sisi lidah menempel gigi geraham</desc>
                    <contoh>
                        <kata arab="ضَ" latin="Dha" arti="huruf Dhad dengan fathah"/>
                    </contoh>
                </item>
                <item id="16" arab="ط" latin="Tha" sound="th" type="huruf">
                    <desc>Dibaca seperti T yang tebal, lidah menyentuh gigi dengan tekanan</desc>
                    <contoh>
                        <kata arab="طَ" latin="Tha" arti="huruf Tha dengan fathah"/>
                    </contoh>
                </item>
                <item id="17" arab="ظ" latin="Zha" sound="zh" type="huruf">
                    <desc>Dibaca seperti Z yang tebal, lidah di antara gigi dengan tekanan</desc>
                    <contoh>
                        <kata arab="ظَ" latin="Zha" arti="huruf Zha dengan fathah"/>
                    </contoh>
                </item>
                <item id="18" arab="ع" latin="Ain" sound="'" type="huruf">
                    <desc>Dibaca dengan menahan suara di tenggorokan bagian tengah, seperti batuk halus</desc>
                    <contoh>
                        <kata arab="عَ" latin="'a" arti="huruf Ain dengan fathah"/>
                    </contoh>
                </item>
                <item id="19" arab="غ" latin="Ghain" sound="gh" type="huruf">
                    <desc>Dibaca seperti gargling (berkumur), getaran tenggorokan bagian belakang</desc>
                    <contoh>
                        <kata arab="غَ" latin="Gha" arti="huruf Ghain dengan fathah"/>
                    </contoh>
                </item>
                <item id="20" arab="ف" latin="Fa" sound="f" type="huruf">
                    <desc>Dibaca seperti huruf F pada kata 'foto', bibir bawah menyentuh gigi atas</desc>
                    <contoh>
                        <kata arab="فَ" latin="Fa" arti="huruf Fa dengan fathah"/>
                    </contoh>
                </item>
                <item id="21" arab="ق" latin="Qaf" sound="q" type="huruf">
                    <desc>Dibaca seperti K yang dalam dari tenggorokan bagian belakang</desc>
                    <contoh>
                        <kata arab="قَ" latin="Qa" arti="huruf Qaf dengan fathah"/>
                    </contoh>
                </item>
                <item id="22" arab="ك" latin="Kaf" sound="k" type="huruf">
                    <desc>Dibaca seperti huruf K pada kata 'kaki', dari bagian tengah tenggorokan</desc>
                    <contoh>
                        <kata arab="كَ" latin="Ka" arti="huruf Kaf dengan fathah"/>
                    </contoh>
                </item>
                <item id="23" arab="ل" latin="Lam" sound="l" type="huruf">
                    <desc>Dibaca seperti huruf L pada kata 'lampu', ujung lidah menyentuh gigi seri atas</desc>
                    <contoh>
                        <kata arab="لَ" latin="La" arti="huruf Lam dengan fathah"/>
                    </contoh>
                </item>
                <item id="24" arab="م" latin="Mim" sound="m" type="huruf">
                    <desc>Dibaca seperti huruf M pada kata 'makan', bibir rapat lalu dibuka</desc>
                    <contoh>
                        <kata arab="مَ" latin="Ma" arti="huruf Mim dengan fathah"/>
                    </contoh>
                </item>
                <item id="25" arab="ن" latin="Nun" sound="n" type="huruf">
                    <desc>Dibaca seperti huruf N pada kata 'nasi', ujung lidah di gigi seri atas</desc>
                    <contoh>
                        <kata arab="نَ" latin="Na" arti="huruf Nun dengan fathah"/>
                    </contoh>
                </item>
                <item id="26" arab="و" latin="Waw" sound="w" type="huruf">
                    <desc>Dibaca seperti huruf W pada kata 'waktu', bibir bundar ke depan</desc>
                    <contoh>
                        <kata arab="وَ" latin="Wa" arti="huruf Waw dengan fathah"/>
                    </contoh>
                </item>
                <item id="27" arab="ه" latin="Ha" sound="h" type="huruf">
                    <desc>Dibaca seperti huruf H pada kata 'hari', lembut dari tenggorokan</desc>
                    <contoh>
                        <kata arab="هَ" latin="Ha" arti="huruf Ha dengan fathah"/>
                    </contoh>
                </item>
                <item id="28" arab="ي" latin="Ya" sound="y" type="huruf">
                    <desc>Dibaca seperti huruf Y pada kata 'yakin', tengah lidah ke langit-langit</desc>
                    <contoh>
                        <kata arab="يَ" latin="Ya" arti="huruf Ya dengan fathah"/>
                    </contoh>
                </item>
            </materi>
            <drills>
                <drill id="1" type="match">
                    <question>Pasangkan huruf Arab dengan latinnya!</question>
                    <pairs>
                        <pair arab="ا" latin="Alif"/>
                        <pair arab="ب" latin="Ba"/>
                        <pair arab="ت" latin="Ta"/>
                        <pair arab="ث" latin="Tsa"/>
                        <pair arab="ج" latin="Jim"/>
                    </pairs>
                </drill>
                <drill id="2" type="identify">
                    <question>Huruf apakah ini?</question>
                    <item arab="ج" answer="Jim"/>
