                    </jawaban>
                </soal>
                <soal id="4" type="pilihan">
                    <pertanyaan>Bagaimana cara membaca: نًا ?</pertanyaan>
                    <jawaban benar="nan">
                        <pilihan>na</pilihan>
                        <pilihan>ni</pilihan>
                        <pilihan>nu</pilihan>
                        <pilihan>nan</pilihan>
                    </jawaban>
                </soal>
                <soal id="5" type="pilihan">
                    <pertanyaan>Manakah yang dibaca "bu"?</pertanyaan>
                    <jawaban benar="بُ">
                        <pilihan>بَ</pilihan>
                        <pilihan>بِ</pilihan>
                        <pilihan>بُ</pilihan>
                        <pilihan>بًا</pilihan>
                    </jawaban>
                </soal>
            </quiz>
        </level>

        <level id="3" name="Sukun &amp; Tasydid" description="Huruf mati dan huruf ganda" locked="true">
            <materi>
                <item id="1" arab="ْ" latin="Sukun" sound="" type="tanda">
                    <desc>Tanda bulat di atas huruf, menandakan huruf tidak bervokal (mati)</desc>
                    <contoh>
                        <kata arab="بْ" latin="B" arti="huruf B tanpa vokal, dibaca 'b' pendek"/>
