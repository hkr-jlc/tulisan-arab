        <level id="4" name="Kata Sederhana" description="Membaca kata-kata dasar" locked="true">
            <materi>
                <item id="1" arab="كِتَابٌ" latin="Kitabun" sound="kitabun" type="kata">
                    <desc>Kata benda yang artinya "buku"</desc>
                    <baca>
                        <huruf h="ka" v="i"/>
                        <huruf h="ta" v="a"/>
                        <huruf h="ba" v="un"/>
                    </baca>
                </item>
                <item id="2" arab="قَلَمٌ" latin="Qalamun" sound="qalamun" type="kata">
                    <desc>Kata benda yang artinya "pulpen"</desc>
                    <baca>
                        <huruf h="qa" v="a"/>
                        <huruf h="la" v="a"/>
                        <huruf h="ma" v="un"/>
                    </baca>
                </item>
                <item id="3" arab="بَيْتٌ" latin="Baytun" sound="baytun" type="kata">
                    <desc>Kata benda yang artinya "rumah"</desc>
                    <baca>
                        <huruf h="ba" v="a"/>
                        <huruf h="ya" v="_"/>
                        <huruf h="ta" v="un"/>
                    </baca>
                </item>
                <item id="4" arab="بَابٌ" latin="Babun" sound="babun" type="kata">
                    <desc>Kata benda yang artinya "pintu"</desc>
                    <baca>
                        <huruf h="ba" v="a"/>
                        <huruf h="ba" v="un"/>
                    </baca>
                </item>
                <item id="5" arab="مَدْرَسَةٌ" latin="Madrasatun" sound="madrasatun" type="kata">
                    <desc>Kata benda yang artinya "sekolah"</desc>
                    <baca>
                        <huruf h="ma" v="a"/>
                        <huruf h="da" v="_"/>
                        <huruf h="ra" v="a"/>
                        <huruf h="sa" v="a"/>
                        <huruf h="ta" v="un"/>
