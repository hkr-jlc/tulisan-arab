                    </jawaban>
                </soal>
                <soal id="3" type="pilihan">
                    <pertanyaan>Huruf apa ini: ح ?</pertanyaan>
                    <jawaban benar="Ha">
                        <pilihan>Kha</pilihan>
                        <pilihan>Jim</pilihan>
                        <pilihan>Ha</pilihan>
                        <pilihan>Dal</pilihan>
                    </jawaban>
                </soal>
                <soal id="4" type="pilihan">
                    <pertanyaan>Huruf apa ini: خ ?</pertanyaan>
                    <jawaban benar="Kha">
                        <pilihan>Ha</pilihan>
                        <pilihan>Kha</pilihan>
                        <pilihan>Dal</pilihan>
