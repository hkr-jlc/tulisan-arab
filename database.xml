                    </contoh>
                </item>
                <item id="2" arab="ّ" latin="Tasydid" sound="" type="tanda">
                    <desc>Tanda seperti huruf W kecil di atas huruf, menandakan huruf digandakan</desc>
                    <contoh>
                        <kata arab="رَّ" latin="Rra" arti="huruf Ra digandakan"/>
                        <kata arab="مُدَّ" latin="Mudda" arti="dilanjutkan"/>
                    </contoh>
                </item>
                <item id="3" arab="ٓ" latin="Maddah" sound="" type="tanda">
                    <desc>Tanda panjang di atas alif, memanjangkan bacaan alif menjadi aa</desc>
                    <contoh>
                        <kata arab="قَالَ" latin="Qaala" arti="dia berkata (dibaca qaa-la)"/>
                    </contoh>
                </item>
            </materi>
            <drills>
