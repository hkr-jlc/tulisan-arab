                    </jawaban>
                </soal>
                <soal id="5" type="pilihan">
                    <pertanyaan>Huruf apa ini: ذ ?</pertanyaan>
                    <jawaban benar="Dzal">
                        <pilihan>Dal</pilihan>
                        <pilihan>Dzal</pilihan>
                        <pilihan>Ra</pilihan>
                        <pilihan>Zay</pilihan>
                    </jawaban>
                </soal>
            </quiz>
        </level>

        <level id="2" name="Harakat (Vokal)" description="Fathah, Kasrah, Dammah" locked="true">
            <materi>
                <item id="1" arab="َ" latin="Fathah" sound="a" type="harakat">
                    <desc>Tanda di atas huruf, dibaca a (seperti pada kata 'adil')</desc>
                    <contoh>
                        <kata arab="بَ" latin="Ba" arti="baca: ba"/>
                        <kata arab="تَ" latin="Ta" arti="baca: ta"/>
                        <kata arab="مَ" latin="Ma" arti="baca: ma"/>
                    </contoh>
                </item>
                <item id="2" arab="ِ" latin="Kasrah" sound="i" type="harakat">
                    <desc>Tanda di bawah huruf, dibaca i (seperti pada kata 'iblis')</desc>
                    <contoh>
                        <kata arab="بِ" latin="Bi" arti="baca: bi"/>
                        <kata arab="تِ" latin="Ti" arti="baca: ti"/>
                        <kata arab="مِ" latin="Mi" arti="baca: mi"/>
                    </contoh>
                </item>
                <item id="3" arab="ُ" latin="Dammah" sound="u" type="harakat">
                    <desc>Tanda di atas huruf seperti waw kecil, dibaca u (seperti pada kata 'ulum')</desc>
                    <contoh>
                        <kata arab="بُ" latin="Bu" arti="baca: bu"/>
                        <kata arab="تُ" latin="Tu" arti="baca: tu"/>
                        <kata arab="مُ" latin="Mu" arti="baca: mu"/>
                    </contoh>
                </item>
                <item id="4" arab="ًا" latin="Tanwin Fathah" sound="an" type="harakat">
                    <desc>Fathah ganda + alif, dibaca an (seperti pada kata 'qolalan')</desc>
                    <contoh>
                        <kata arab="كِتَابًا" latin="Kitaban" arti="sebuah kitab"/>
                    </contoh>
                </item>
                <item id="5" arab="ٍ" latin="Tanwin Kasrah" sound="in" type="harakat">
                    <desc>Kasrah ganda, dibaca in (seperti pada kata 'muslimin')</desc>
                    <contoh>
                        <kata arab="مُسْلِمٍ" latin="Muslimin" arti="seorang muslim (kasus khafad)"/>
                    </contoh>
                </item>
                <item id="6" arab="ٌ" latin="Tanwin Dammah" sound="un" type="harakat">
                    <desc>Dammah ganda, dibaca un (seperti pada kata 'muslimun')</desc>
                    <contoh>
                        <kata arab="مُسْلِمٌ" latin="Muslimun" arti="seorang muslim (kasus rafa')"/>
                    </contoh>
                </item>
            </materi>
            <drills>
                <drill id="1" type="identify_harakat">
                    <question>Harakat apakah ini?</question>
                    <item arab="َ" answer="Fathah"/>
                    <item arab="ِ" answer="Kasrah"/>
                    <item arab="ُ" answer="Dammah"/>
                </drill>
                <drill id="2" type="baca">
                    <question>Bacalah huruf berikut!</question>
                    <item arab="بَ" jawaban="ba"/>
                    <item arab="بِ" jawaban="bi"/>
                    <item arab="بُ" jawaban="bu"/>
                    <item arab="تَ" jawaban="ta"/>
                    <item arab="تِ" jawaban="ti"/>
                    <item arab="تُ" jawaban="tu"/>
                </drill>
            </drills>
            <quiz>
                <soal id="1" type="pilihan">
                    <pertanyaan>Bagaimana cara membaca: بَ ?</pertanyaan>
                    <jawaban benar="ba">
                        <pilihan>bi</pilihan>
                        <pilihan>bu</pilihan>
                        <pilihan>ba</pilihan>
                        <pilihan>be</pilihan>
                    </jawaban>
